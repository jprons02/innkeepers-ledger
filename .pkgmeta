package-as: InnkeepersLedger

# Release notes come from this file, never from commit messages: those hold links, and
# the changelog ships in the package and on the download pages (addon policy).
# scripts/check-release.sh fails a release without it.
manual-changelog:
  filename: CHANGELOG.md
  markup-type: markdown

# The libraries ship byte-for-byte as reviewed: no keyword replacement (LibDeflate's
# header comment holds @project-...@ keywords) or line-ending change.
# scripts/check-package.sh compares them with Libs/MANIFEST.sha256. Each entry is listed
# on its own: plain-copy overrides ignore, so "Libs" would ship the manifest. A new
# library goes here too (docs/libraries.md -> upgrade steps).
plain-copy:
  - Libs/AceAddon-3.0
  - Libs/AceConsole-3.0
  - Libs/AceDB-3.0
  - Libs/AceEvent-3.0
  - Libs/AceSerializer-3.0
  - Libs/CallbackHandler-1.0
  - Libs/ChatThrottleLib
  - Libs/LibDeflate
  - Libs/LibStub
  - Libs/LICENSE-Ace3.txt
  - Libs/embeds.xml

# No externals: what ships is the reviewed Libs/ (docs/libraries.md). Dotfiles and
# folders (.github, .claude, ...) are never packaged; they're listed for clarity.
ignore:
  - docs
  - spec
  - scripts
  - media
  - .claude
  - .github
  - CLAUDE.md
  - CONTRIBUTING.md
  - SECURITY.md
  - .busted
  - .luacheckrc
  - .luacov
  - Libs/MANIFEST.sha256
